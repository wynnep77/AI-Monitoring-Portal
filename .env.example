# Database Configuration
DATABASE_URL=sqlite:///./monitoring.db

# Monitoring Intervals (seconds)
GPU_MONITOR_INTERVAL=5
CPU_MONITOR_INTERVAL=5
STORAGE_MONITOR_INTERVAL=30

# Data Retention (days)
DATA_RETENTION_DAYS=365

# Sampling Rates
HIGH_FREQUENCY_SAMPLING=5
MEDIUM_FREQUENCY_SAMPLING=60
LOW_FREQUENCY_SAMPLING=300
